---
interface Props { lines: string[] }
const { lines } = Astro.props;
---
<div>
  <h2 class="text-[clamp(2rem,3.2vw,2.75rem)] font-medium leading-[1.1] tracking-[-.025em] text-fg/90">
    {lines.map((line, i) => (<>{line}{i < lines.length - 1 && <br />}</>))}
  </h2>
  <div class="mt-5 max-w-[68ch] text-[15px] leading-relaxed text-muted">
    <slot />
  </div>
</div>
