---
interface Props { eyebrow: string; lines: string[] }
const { eyebrow, lines } = Astro.props;
---
<div>
  <p class="text-[11px] uppercase tracking-[0.22em] text-dim">{eyebrow}</p>
  <h2 class="mt-5 text-[clamp(2rem,3.2vw,2.75rem)] font-medium leading-[1.1] tracking-tight text-fg/90">
    {lines.map((line, i) => (<>{line}{i < lines.length - 1 && <br />}</>))}
  </h2>
  <div class="mt-6 max-w-sm text-[15px] leading-relaxed text-muted">
    <slot />
  </div>
</div>
