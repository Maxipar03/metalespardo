---
interface Props { name: 'corte' | 'doblado' | 'soldadura' | 'terminacion'; class?: string }
const { name, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'corte' && (
    <>
      <path d="M6 20 26 9l16 10-20 12z" />
      <path d="M6 20v5l16 11 20-12v-5" />
      <path d="M16 22l7 4 9-5" stroke-dasharray="2 2.5" />
      <rect x="25" y="17" width="5" height="3" transform="rotate(30 27 18)" />
    </>
  )}
  {name === 'doblado' && (
    <>
      <path d="M8 12h32M8 12v9M40 12v9" />
      <path d="M13 21h22M24 21v11" />
      <path d="M17 34h14M20 38h8" />
      <path d="M13 21l-3 6h28l-3-6" opacity=".55" />
    </>
  )}
  {name === 'soldadura' && (
    <>
      <path d="M24 19v-9M15 21l-5-5M33 21l5-5M12 26H5M36 26h7" />
      <path d="M24 24l-9 12" />
      <path d="M6 38h36" />
      <circle cx="24" cy="25" r="2" />
    </>
  )}
  {name === 'terminacion' && (
    <>
      <circle cx="16" cy="15" r="6" />
      <circle cx="16" cy="15" r="2.5" />
      <circle cx="32" cy="21" r="7" />
      <circle cx="32" cy="21" r="3" />
      <circle cx="17" cy="35" r="5" />
      <path d="M13 34l8 2" />
    </>
  )}
</svg>
