---
import { productos } from '../data/content';
const whatsapp = 'https://wa.me/5491126790946?text=Hola%2C%20quisiera%20consultar%20por%20otros%20productos.';
const productWhatsapp = (title: string) => `https://wa.me/5491126790946?text=${encodeURIComponent(`Hola, quisiera consultar por ${title.toLowerCase()}.`)}`;
---

<section class="catalog-section section-pad" id="productos" aria-labelledby="catalog-title">
  <div class="shell">
    <div class="section-intro catalog-intro">
      <h2 id="catalog-title">El metal abre<br /><span>otras posibilidades.</span></h2>
      <div>
        <p>Además del trefilado para iluminación, recibimos consultas por otros productos. La disponibilidad y las especificaciones se confirman para cada pedido.</p>
        <a class="text-link" href={whatsapp} target="_blank" rel="noopener noreferrer">Consultar disponibilidad <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="catalog-grid">
      {productos.map((product, index) => (
        <a class:list={['catalog-item', `catalog-item-${index + 1}`]} href={productWhatsapp(product.title)} target="_blank" rel="noopener noreferrer" aria-label={`Consultar por ${product.title} en WhatsApp`}>
          <img src={product.image} alt="" loading="lazy" width="800" height="600" />
          <div class="catalog-item-label"><span>{product.title}</span><span aria-hidden="true">↗</span></div>
        </a>
      ))}
    </div>
  </div>
</section>
