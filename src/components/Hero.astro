---
import ArrowRight from './icons/ArrowRight.astro';
const whatsapp = 'https://wa.me/5491126790946?text=Hola%2C%20quisiera%20consultar%20por%20trefilado%20y%20roscado%20de%20ca%C3%B1os.';
---

<section id="inicio" class="relative isolate flex min-h-[max(780px,100svh)] overflow-hidden bg-ink max-[900px]:min-h-200 max-[600px]:min-h-[max(760px,100svh)]" aria-labelledby="hero-title">
  <img class="absolute inset-0 -z-2 h-full w-full object-cover object-[65%_center] max-[600px]:object-[72%_center]" src="/trefilado-hero-concept.webp" alt="" width="2048" height="1024" fetchpriority="high" />
  <div class="absolute inset-0 -z-1 [background:linear-gradient(90deg,#0b0d0e_0%,rgba(11,13,14,.93)_25%,rgba(11,13,14,.48)_60%,rgba(11,13,14,.15)_100%),linear-gradient(0deg,#0b0d0e,transparent_45%)] max-[600px]:[background:linear-gradient(0deg,#0b0d0e_0%,rgba(11,13,14,.9)_45%,rgba(11,13,14,.45)_100%)]" aria-hidden="true"></div>
  <div class="mx-auto flex w-[min(100%_-_96px,1440px)] flex-col justify-end pt-40 max-[900px]:w-[min(100%_-_48px,720px)] max-[600px]:w-[calc(100%_-_40px)] max-[600px]:pt-34">
    <div class="pb-[clamp(60px,7vw,110px)]">
      <h1 id="hero-title" class="max-w-240 font-display text-[clamp(72px,7.4vw,96px)] font-semibold uppercase leading-[.9] tracking-[-.025em] max-[900px]:text-[clamp(68px,10vw,88px)] max-[600px]:text-[clamp(52px,13.8vw,78px)]">Trefilado <span class="text-copper">&amp; roscado.</span><span class="mt-2 block text-[#c5c9c7]">Caños que toman forma.</span></h1>
      <p class="mt-7 max-w-135 text-[15px] leading-[1.8] text-[#e1e3df] max-[600px]:text-sm">Trefilado para fabricantes de iluminación y roscado de caños. Dos procesos, una misma atención a lo que tu proyecto necesita.</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4 max-[600px]:flex-col max-[600px]:items-start">
        <a class="group inline-flex min-h-14 max-w-full items-center justify-between gap-7 bg-copper px-6 py-4 text-xs font-bold text-ink transition-colors duration-200 hover:bg-[#f0c69a]" href={whatsapp} target="_blank" rel="noopener noreferrer">Consultar un proyecto<ArrowRight class="size-5 -rotate-45 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" /></a>
        <a class="group inline-flex min-h-11 items-center gap-4 border-b border-steel/60 text-xs font-semibold transition-colors hover:text-copper" href="#proceso">Explorá los procesos<ArrowRight class="size-4 rotate-90 transition-transform group-hover:translate-y-1" /></a>
      </div>
    </div>
    <div class="grid grid-cols-[1fr_1fr_auto] gap-8 border-t border-white/25 py-6 max-[600px]:grid-cols-2 max-[600px]:gap-4 max-[600px]:py-5">
      <a class="group flex items-center justify-between gap-4 border-r border-white/20 pr-8 max-[600px]:pr-4" href="#proceso"><span><strong class="block font-display text-2xl font-semibold uppercase">Trefilado</strong><small class="mt-1 block text-[11px] text-steel">La forma del caño.</small></span><ArrowRight class="size-5 text-copper transition-transform group-hover:translate-x-1" /></a>
      <a class="group flex items-center justify-between gap-4" href="#roscado"><span><strong class="block font-display text-2xl font-semibold uppercase">Roscado</strong><small class="mt-1 block text-[11px] text-steel">El detalle de la unión.</small></span><ArrowRight class="size-5 text-copper transition-transform group-hover:translate-x-1" /></a>
      <span class="self-center text-right text-[9px] leading-relaxed tracking-[.12em] text-steel max-[900px]:max-w-28 max-[600px]:col-span-2 max-[600px]:max-w-none max-[600px]:text-left max-[600px]:text-[8px]">IMAGEN CONCEPTUAL<br class="max-[600px]:hidden" /> DEL TREFILADO</span>
    </div>
  </div>
</section>
