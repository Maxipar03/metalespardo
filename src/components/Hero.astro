---
const whatsapp = 'https://wa.me/5491126790946?text=Hola%2C%20quisiera%20consultar%20por%20trefilado%20de%20ca%C3%B1os.';
---

<section class="hero" aria-labelledby="hero-title">
  <img class="hero-image" src="/trefilado-hero-concept.webp" alt="" width="2048" height="1024" fetchpriority="high" />
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="shell hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">Trefilado de caños <span>para iluminación.</span></h1>
      <p>Caños Pardo trabaja con fabricantes de iluminación y recibe consultas por otros productos y proyectos a medida.</p>
      <div class="hero-actions">
        <a class="action action-primary" href={whatsapp} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#proceso">Conocé el proceso <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero-bottom">
      <span>Precisión que toma forma.</span>
      <span class="hero-bottom-note">IMAGEN CONCEPTUAL DEL PROCESO</span>
    </div>
  </div>
</section>
