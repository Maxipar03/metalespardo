---
import Button from './Button.astro';
---
<section class="relative isolate overflow-hidden">
  <!-- Imagen de fondo -->
  <div class="absolute inset-y-0 right-0 -z-10 w-full opacity-60 lg:w-[64%] lg:opacity-100" aria-hidden="true">
    <img
      src="/hero-perfiles.webp"
      alt=""
      width="2000"
      height="1400"
      fetchpriority="high"
      class="h-full w-full object-cover object-right"
      onerror="this.style.display='none'"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/50 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink to-transparent"></div>
  </div>

  <!-- Contenido -->
  <div class="mx-auto flex min-h-[640px] max-w-[1440px] flex-col justify-center px-6 pb-20 pt-36 md:px-12 lg:min-h-[760px]">
    <span class="w-fit rounded-full border border-line bg-white/[0.03] px-3.5 py-1.5 text-[10px] uppercase tracking-[0.22em] text-muted">
      Metalúrgica industrial
    </span>

    <h1 class="mt-7 max-w-[14ch] text-[clamp(2.5rem,5vw,4.25rem)] font-medium leading-[1.06] tracking-tight text-fg sm:max-w-none">
      Soluciones en metal<br class="hidden sm:block" />
      para la industria<br class="hidden sm:block" />
      y la iluminación.
    </h1>

    <p class="mt-7 max-w-md text-[17px] leading-relaxed text-fg/80">
      Fabricamos y proveemos productos metálicos de alta calidad para empresas que crean, diseñan y producen.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-8">
      <Button href="#catalogo" variant="solid">Ver catálogo</Button>
      <a href="#proceso" class="border-b border-line pb-1.5 pr-14 text-[12px] text-muted transition-colors hover:border-white/40 hover:text-fg">
        Conocé más
      </a>
    </div>
  </div>

  <!-- Contador decorativo -->
  <div class="pointer-events-none absolute right-12 top-1/2 hidden -translate-y-1/2 flex-col items-center gap-3 lg:flex" aria-hidden="true">
    <span class="h-14 w-px bg-line"></span>
    <p class="text-[15px] text-fg">01<span class="ml-1 text-[9px] text-dim">/ 04</span></p>
    <span class="h-14 w-px bg-gradient-to-b from-fg/60 to-transparent"></span>
  </div>

  <p class="absolute bottom-10 right-12 hidden max-w-[11rem] text-[11px] leading-relaxed text-fg/70 lg:block">
    Materiales que dan forma a tus proyectos.
  </p>
</section>
