---
import Logo from './Logo.astro';
import { nav, tagline } from '../data/content';

const social = [
  { label: 'Instagram', href: '#', path: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm5-2.3v.01' },
  { label: 'LinkedIn', href: '#', path: 'M4 9v11M4 4.5v.01M9 20V9m0 4a4 4 0 0 1 8 0v7' },
  { label: 'Email', href: 'mailto:info@jema.com.ar', path: 'M3 6h18v12H3zM3 7l9 6 9-6' },
];
---
<footer class="border-t border-line">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-8 px-6 py-10 md:px-12 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
      <a href="/" aria-label="JEMA — inicio" class="text-fg"><Logo class="h-[16px]" /></a>
      <p class="flex items-center gap-4 text-[12px] text-fg/80">
        <span class="hidden h-px w-14 bg-line sm:block" aria-hidden="true"></span>
        {tagline}
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-x-10 gap-y-5">
      <nav aria-label="Pie de página">
        <ul class="flex flex-wrap gap-x-8 gap-y-2 text-[11px] text-muted">
          {nav.map((item) => (
            <li><a href={item.href} class="transition-colors hover:text-fg">{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <ul class="flex items-center gap-5 text-fg/80">
        {social.map((s) => (
          <li>
            <a href={s.href} aria-label={s.label} class="block transition-colors hover:text-white">
              <svg class="size-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.path} /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
