---
import { nav, tagline } from '../data/content';
const whatsapp = 'https://wa.me/5491126790946?text=Hola%2C%20quisiera%20consultar%20por%20un%20proyecto.';
---

<footer class="footer" id="contacto">
  <div class="shell">
    <div class="footer-main">
      <h2>Tu proyecto empieza <span>con una consulta.</span></h2>
      <p>Contanos qué necesitás. Estamos para conversar sobre trefilado de caños, otros productos y trabajos a medida.</p>
      <div class="footer-actions">
        <a class="action action-primary" href={whatsapp} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp <span aria-hidden="true">↗</span></a>
        <a class="action action-outline" href="mailto:Javierpardo08@gmail.com?subject=Consulta%20para%20Ca%C3%B1os%20Pardo">Enviar un correo <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <nav class="footer-nav" aria-label="Enlaces del pie de página">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="footer-meta">
      <a class="footer-brand" href="#inicio"><img src="/pardoHnosLogo.svg" alt="" width="28" height="36" /><span>CAÑOS PARDO<small>{tagline}.</small></span></a>
      <div class="footer-contact"><a href="https://wa.me/5491126790946" target="_blank" rel="noopener noreferrer">+54 9 11 2679 0946</a><a href="mailto:Javierpardo08@gmail.com">Javierpardo08@gmail.com</a></div>
      <span class="copyright">© {new Date().getFullYear()} Caños Pardo</span>
    </div>
  </div>
</footer>
