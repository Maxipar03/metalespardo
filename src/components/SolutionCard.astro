---
interface Props { title: string; image: string }
const { title, image } = Astro.props;
---
<figure
  class="relative flex aspect-[4/3] flex-col justify-end overflow-hidden border border-line bg-[#17191a] md:aspect-[4/5]"
>
  <img
    src={image}
    alt=""
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover"
    onerror="this.style.display='none'"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent" aria-hidden="true"></div>
  <figcaption class="relative p-4 text-[13px] font-medium text-fg">{title}</figcaption>
</figure>
