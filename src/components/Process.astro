<section class="process-section section-pad" id="proceso" data-process aria-labelledby="process-title">
  <div class="shell">
    <div class="section-intro process-intro">
      <h2 id="process-title">El caño atraviesa.<br /><span>La forma cambia.</span></h2>
      <p>El trefilado transforma la sección de un caño al hacerlo pasar por una matriz. Esta secuencia muestra el principio del proceso de manera simplificada.</p>
    </div>

    <div class="process-layout">
      <div class="process-sticky">
        <div class="process-stage" aria-hidden="true">
          <div class="process-stage-top"><span>DEL MATERIAL A LA FORMA</span><span>CAÑOS PARDO</span></div>
          <svg class="process-diagram" viewBox="0 0 1100 420" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
            <defs>
              <linearGradient id="tube-base" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#4c5153"/><stop offset=".2" stop-color="#8c9293"/><stop offset=".51" stop-color="#313638"/><stop offset=".78" stop-color="#707779"/><stop offset="1" stop-color="#252a2c"/>
              </linearGradient>
              <linearGradient id="tube-light" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#9ba3a3"/><stop offset=".18" stop-color="#f1eee5"/><stop offset=".47" stop-color="#777e80"/><stop offset=".78" stop-color="#d7dad7"/><stop offset="1" stop-color="#555d5f"/>
              </linearGradient>
              <linearGradient id="die" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#232728"/><stop offset=".47" stop-color="#555b5c"/><stop offset="1" stop-color="#191c1e"/>
              </linearGradient>
              <clipPath id="input-window"><rect x="0" y="85" width="552" height="250" /></clipPath>
            </defs>
            <path d="M0 112H406C455 112 474 140 533 154H1100V266H533C474 280 455 308 406 308H0Z" fill="url(#tube-base)" opacity=".25"/>
            <g class="process-incoming" clip-path="url(#input-window)">
              <path d="M-80 112H406C455 112 474 140 533 154H585V266H533C474 280 455 308 406 308H-80Z" fill="url(#tube-light)"/>
              <path d="M-80 133H405C450 133 478 159 531 171H585" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="3"/>
              <path d="M-80 287H405C450 287 478 261 531 249H585" fill="none" stroke="#0b0e0f" stroke-opacity=".5" stroke-width="4"/>
            </g>
            <g class="process-outgoing">
              <path d="M552 154H1100V266H552Z" fill="url(#tube-light)"/>
              <path d="M552 171H1100" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="3"/>
              <path d="M552 249H1100" fill="none" stroke="#0b0e0f" stroke-opacity=".5" stroke-width="4"/>
            </g>
            <path d="M484 38H616V150L579 166H539L484 142Z M484 278L539 254H579L616 270V382H484Z" fill="url(#die)" stroke="#909799" stroke-opacity=".45" stroke-width="2"/>
            <path d="M496 49H603M496 371H603" stroke="#b6bbba" stroke-opacity=".48" stroke-width="3"/>
            <path d="M0 352H435M650 352H1100" stroke="#737a79" stroke-opacity=".45" stroke-width="1" stroke-dasharray="7 9"/>
            <path d="M404 339V365M650 339V365" stroke="#929a98" stroke-opacity=".7" stroke-width="1"/>
          </svg>
          <div class="process-stage-bottom"><span>SECCIÓN INICIAL</span><span>MATRIZ</span><span>SECCIÓN RESULTANTE</span></div>
        </div>
        <p class="process-caption">Representación conceptual del trefilado. La configuración depende de cada proyecto.</p>
      </div>

      <ol class="process-steps">
        <li><span class="process-index">01</span><h3>El caño de partida</h3><p>Una pieza inicial entra en el proceso con la sección que se busca transformar.</p></li>
        <li><span class="process-index">02</span><h3>El paso por la matriz</h3><p>El caño se tracciona a través de una matriz que guía el cambio de sección.</p></li>
        <li><span class="process-index">03</span><h3>La forma resultante</h3><p>La geometría final responde al trabajo definido para la pieza. Cada necesidad se evalúa antes de cotizar.</p></li>
      </ol>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-process]');
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktopQuery = window.matchMedia('(min-width: 900px)');
  if (section) {
    let scheduled = false;
    const render = () => {
      if (!desktopQuery.matches || motionQuery.matches) {
        section.style.removeProperty('--travel');
        section.style.removeProperty('--reveal');
        scheduled = false;
        return;
      }
      const rect = section.getBoundingClientRect();
      const distance = Math.max(1, rect.height - window.innerHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / distance));
      const advance = Math.min(1, progress * 2.2);
      const emergence = Math.min(1, Math.max(0, (progress - .18) / .82));
      section.style.setProperty('--travel', `${-70 + advance * 70}px`);
      section.style.setProperty('--reveal', `${(1 - emergence) * 100}%`);
      scheduled = false;
    };
    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(render);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    desktopQuery.addEventListener('change', schedule);
    motionQuery.addEventListener('change', schedule);
    schedule();
  }
</script>
