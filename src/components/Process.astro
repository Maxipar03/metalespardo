<script>
  import { bindProcessMotion } from '../scripts/process-motion';
  const section = document.querySelector<HTMLElement>('[data-process]');
  if (section) {
    bindProcessMotion(section, progress => {
      const advance = 1 - Math.pow(1 - Math.min(1, progress * 1.8), 3);
      const emergence = Math.min(1, Math.max(0, (progress - .12) / .88));
      section.style.setProperty('--travel', `${-70 + advance * 70}px`);
      section.style.setProperty('--reveal', `${(1 - emergence) * 100}%`);
    }, () => {
      section.style.removeProperty('--travel');
      section.style.removeProperty('--reveal');
    });
  }
</script>
