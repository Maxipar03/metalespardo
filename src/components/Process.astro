---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import ProcessIcon from './icons/ProcessIcon.astro';
import { proceso } from '../data/content';
---
<Section id="proceso">
  <div class="grid gap-14 xl:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] xl:gap-8">
    <SectionHeading eyebrow="Nuestro proceso" lines={['Del metal', 'al resultado.']}>
      Combinamos tecnología, precisión y experiencia para ofrecerte productos confiables, con la calidad y terminación que tu proyecto necesita.
    </SectionHeading>

    <ol class="grid grid-cols-2 gap-y-10 lg:grid-cols-4">
      {proceso.map((step, i) => (
        <li class="border-l border-line px-5 odd:border-l-0 sm:px-6 lg:odd:border-l">
          <p class="text-[15px] text-dim">{String(i + 1).padStart(2, '0')}</p>
          <ProcessIcon name={step.icon} class="mt-7 size-11 text-fg/80" />
          <h3 class="mt-5 text-[15px] font-medium text-fg">{step.title}</h3>
          <p class="mt-3 text-[13px] leading-relaxed text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</Section>
