---
// Edita este arreglo para cambiar los productos destacados.
// El primero se muestra como tarjeta grande.
// `image` es opcional: si queda vacío se muestra un espacio reservado.
const products = [
  {
    name: "Alambre trefilado",
    category: "Alambre",
    description:
      "Alambre en distintos diámetros, listo para conformar, soldar o ensamblar en tu línea de producción.",
    tags: ["Iluminación", "Mobiliario", "Equipamiento"],
    image: "",
    href: "/productos",
  },
  {
    name: "Varillas",
    category: "Varillas",
    description:
      "Varillas rectas cortadas a la medida que necesitás para estructuras y soportes.",
    tags: ["Mobiliario", "Equipamiento"],
    image: "",
    href: "/productos",
  },
  {
    name: "Piezas de alambre conformado",
    category: "Componentes",
    description:
      "Aros, ganchos y formas especiales fabricadas según tu plano o muestra.",
    tags: ["Iluminación", "Mobiliario"],
    image: "",
    href: "/productos",
  },
];
---

<section id="catalogo" class="border-t border-white/10 bg-zinc-950">
  <div class="mx-auto max-w-7xl px-6 py-24 lg:py-32">
    <div
      class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
    >
      <div class="max-w-2xl">
        <h2
          class="text-4xl font-semibold tracking-tight text-white md:text-5xl"
        >
          Catálogo destacado
        </h2>

        <p class="mt-6 text-lg leading-8 text-zinc-400">
          Una selección de los componentes que fabricamos y proveemos.
        </p>
      </div>

      <a
        href="/productos"
        class="group inline-flex w-fit items-center gap-2 rounded-full border border-zinc-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-zinc-900"
      >
        Ver catálogo completo
        <svg
          viewBox="0 0 20 20"
          fill="none"
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          <path
            d="M4 10h11M10 5l5 5-5 5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div
      class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-2"
    >
      {
        products.map((product, index) => {
          const featured = index === 0;

          return (
            <a
              href={product.href}
              class:list={[
                "group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] transition duration-300 hover:border-orange-500/40",
                featured && "md:col-span-2 lg:row-span-2",
              ]}
            >
              <div
                class:list={[
                  "relative overflow-hidden bg-zinc-900",
                  featured ? "min-h-64 flex-1" : "aspect-[16/10]",
                ]}
              >
                {product.image ? (
                  <img
                    src={product.image}
                    alt={product.name}
                    loading="lazy"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center text-zinc-700">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      class="h-12 w-12"
                      aria-hidden="true"
                    >
                      <path
                        d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3zM12 12l8-4.5M12 12v9M12 12L4 7.5"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                )}
              </div>

              <div class:list={["p-6", featured && "lg:p-8"]}>
                <p class="text-sm text-zinc-500">{product.category}</p>

                <h3
                  class:list={[
                    "mt-2 font-semibold tracking-tight text-white",
                    featured ? "text-2xl" : "text-xl",
                  ]}
                >
                  {product.name}
                </h3>

                <p class="mt-3 max-w-xl leading-7 text-zinc-400">
                  {product.description}
                </p>

                <ul class="mt-5 flex flex-wrap gap-2">
                  {product.tags.map((tag) => (
                    <li class="rounded-full border border-white/10 px-3 py-1 text-xs text-zinc-400">
                      {tag}
                    </li>
                  ))}
                </ul>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>