---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import SolutionCard from './SolutionCard.astro';
import Button from './Button.astro';
import { soluciones } from '../data/content';
---
<Section id="soluciones" class="py-24 md:py-36">
  <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(18rem,.85fr)] md:items-center md:gap-16">
    <div>
      <SectionHeading lines={['Trefilado para', 'fabricantes de iluminación.']}>
        El trefilado de tubos es nuestra oferta central. Para otras necesidades, contanos qué requiere tu proyecto.
      </SectionHeading>
      <Button href="#contacto" class="mt-8">Hablar sobre un proyecto</Button>
    </div>
    {soluciones.map((s) => <SolutionCard {...s} />)}
  </div>
</Section>
