---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import SolutionCard from './SolutionCard.astro';
import Button from './Button.astro';
import { soluciones } from '../data/content';
---
<Section id="soluciones">
  <div class="grid gap-12 xl:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] xl:gap-14">
    <div class="flex flex-col items-start">
      <SectionHeading eyebrow="Soluciones" lines={['Metal para', 'cada proyecto.']}>
        Abastecemos a empresas de iluminación, mobiliario, construcción y más. Adaptamos nuestras soluciones a tus necesidades, con asesoramiento técnico y entregas eficientes.
      </SectionHeading>
      <Button href="#soluciones" class="mt-9">Ver soluciones</Button>
    </div>

    <div class="grid grid-cols-2 gap-2 lg:grid-cols-4">
      {soluciones.map((s) => <SolutionCard {...s} />)}
    </div>
  </div>
</Section>
