---
import '../styles/global.css';

interface Props { title?: string; description?: string }
const {
  title = 'JEMA — Metal que impulsa tus ideas',
  description = 'Fabricamos y proveemos productos metálicos de alta calidad para empresas de iluminación, mobiliario y construcción.',
} = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-ink text-fg">
    <slot />
  </body>
</html>
